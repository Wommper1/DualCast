<Window x:Class="DualBluetooth.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="DualCast — Dual Bluetooth Streamer" Width="1060" Height="800"
        MinWidth="900" MinHeight="680" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SectionDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,18" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="30,25,30,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="46" Height="46" CornerRadius="12" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#64D8FF" Offset="0" /><GradientStop Color="#087DB8" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Path Stroke="White" StrokeThickness="2.4" StrokeLineJoin="Round" Data="M 20,8 L 29,16 L 21,23 L 29,30 L 20,38 L 20,8 M 13,15 L 27,28 M 13,31 L 27,18" />
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="27" FontWeight="Bold" Text="DualCast" />
                    <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}" Text="One system mix. Two Bluetooth outputs." />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SettingsButton" Style="{StaticResource QuietButton}" Width="42" Height="42" Padding="0" Margin="0,0,10,0"
                        Click="Settings_Click" ToolTip="Appearance and app settings" automation:AutomationProperties.Name="Open settings">
                    <TextBlock FontFamily="Segoe UI Symbol" FontSize="18" Text="⚙" />
                </Button>
                <Border Padding="13,8" CornerRadius="16" Background="{DynamicResource PanelRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#73829A" Margin="0,0,8,0" />
                        <TextBlock x:Name="HeaderStatusText" Text="Ready" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Popup x:Name="SettingsPopup" Grid.Column="1" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom"
                   HorizontalOffset="-300" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Width="350" Padding="20" CornerRadius="13" Background="{DynamicResource PanelRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Settings" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource QuietButton}" Width="34" Height="34" Padding="0"
                                    Click="CloseSettings_Click" Content="×" automation:AutomationProperties.Name="Close settings" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="COLOR THEME" />
                        <ComboBox x:Name="ThemeCombo" SelectionChanged="AppearanceSettingChanged" automation:AutomationProperties.Name="Color theme">
                            <ComboBoxItem Tag="Midnight">Midnight blue</ComboBoxItem>
                            <ComboBoxItem Tag="Graphite">Graphite</ComboBoxItem>
                            <ComboBoxItem Tag="Oled">OLED black</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,7" Text="ACCENT COLOR" />
                        <ComboBox x:Name="AccentCombo" SelectionChanged="AppearanceSettingChanged" automation:AutomationProperties.Name="Accent color">
                            <ComboBoxItem Tag="Ocean">Ocean blue</ComboBoxItem>
                            <ComboBoxItem Tag="Violet">Electric violet</ComboBoxItem>
                            <ComboBoxItem Tag="Emerald">Emerald</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,7" Text="TEXT SIZE" />
                        <ComboBox x:Name="TextSizeCombo" SelectionChanged="AppearanceSettingChanged" automation:AutomationProperties.Name="Text size">
                            <ComboBoxItem Tag="14">Standard</ComboBoxItem>
                            <ComboBoxItem Tag="16">Large</ComboBoxItem>
                        </ComboBox>
                        <CheckBox x:Name="HighVisibilityCheck" Margin="0,18,0,0" Content="Stronger borders and contrast" Click="AppearanceSettingChanged_Click" />
                        <CheckBox x:Name="AlwaysOnTopCheck" Margin="0,18,0,0" Content="Keep DualCast above other windows" Click="AppearanceSettingChanged_Click" />
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,18,0,14" />
                        <Button Style="{StaticResource SecondaryButton}" Click="ResetAppearance_Click" Content="Reset appearance" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <ScrollViewer Grid.Row="1" Background="{DynamicResource WindowBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,0,20,10">
            <StackPanel>
                <Border Margin="0,0,0,14" CornerRadius="15" BorderBrush="#245577" BorderThickness="1" Padding="22">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#102A3D" Offset="0" /><GradientStop Color="#101927" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#174D68" CornerRadius="10" Padding="9,4" Margin="0,0,8,0"><TextBlock Foreground="#9EE7FF" FontSize="11" FontWeight="Bold" Text="SYSTEM MIX" /></Border>
                                <Border Background="#174434" CornerRadius="10" Padding="9,4"><TextBlock Foreground="#8FF2C8" FontSize="11" FontWeight="Bold" Text="FEEDBACK EXCLUDED" /></Border>
                            </StackPanel>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="DualCast captures Windows audio automatically" />
                            <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                       Text="No capture-source juggling or silent speaker endpoint required. Audio produced by DualCast itself is excluded from capture." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <Button Style="{StaticResource QuietButton}" Click="OpenBluetoothSettings_Click" Content="Bluetooth devices" />
                            <Button Style="{StaticResource QuietButton}" Margin="0,8,0,0" Click="OpenSoundSettings_Click" Content="Windows sound settings" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Choose outputs" />
                                <TextBlock Foreground="{DynamicResource MutedBrush}" Text="Both devices must be paired, connected, and available as Windows playback endpoints." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="ShowUnavailableCheck" Margin="0,0,16,0" Content="Show disconnected" Click="ShowUnavailable_Click" />
                                <Button Style="{StaticResource QuietButton}" Click="RefreshDevices_Click" Content="↻  Refresh devices" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="28" Height="28" Background="#126C94" CornerRadius="8" Margin="0,0,10,0"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Text="A" /></Border>
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="First Bluetooth output" />
                                    </StackPanel>
                                    <Grid>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="PLAYBACK DEVICE" />
                                        <Button x:Name="FavoriteAButton" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" MinHeight="30" Padding="9,4"
                                                Click="FavoriteA_Click" Content="☆ Favorite" automation:AutomationProperties.Name="Favorite output A device" />
                                    </Grid>
                                    <ComboBox x:Name="OutputACombo" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="SettingChanged"
                                              automation:AutomationProperties.Name="Output A playback device" />
                                    <Grid Margin="0,18,0,4"><TextBlock Text="Volume" FontWeight="SemiBold" /><TextBlock x:Name="VolumeAText" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" /></Grid>
                                    <Slider x:Name="VolumeASlider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="VolumeSlider_ValueChanged"
                                            automation:AutomationProperties.Name="Output A volume" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="28" Height="28" Background="#3164B4" CornerRadius="8" Margin="0,0,10,0"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Text="B" /></Border>
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Second Bluetooth output" />
                                    </StackPanel>
                                    <Grid>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="PLAYBACK DEVICE" />
                                        <Button x:Name="FavoriteBButton" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" MinHeight="30" Padding="9,4"
                                                Click="FavoriteB_Click" Content="☆ Favorite" automation:AutomationProperties.Name="Favorite output B device" />
                                    </Grid>
                                    <ComboBox x:Name="OutputBCombo" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="SettingChanged"
                                              automation:AutomationProperties.Name="Output B playback device" />
                                    <Grid Margin="0,18,0,4"><TextBlock Text="Volume" FontWeight="SemiBold" /><TextBlock x:Name="VolumeBText" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" /></Grid>
                                    <Slider x:Name="VolumeBSlider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="VolumeSlider_ValueChanged"
                                            automation:AutomationProperties.Name="Output B volume" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Sync calibration" />
                        <TextBlock Style="{StaticResource SectionDescription}" Text="Play four pulses. Add delay to whichever device you hear first, then repeat until both pulses overlap." />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <Grid Margin="0,0,0,4"><TextBlock Text="Output A delay" FontWeight="SemiBold" /><TextBlock x:Name="DelayAText" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" /></Grid>
                                <Slider x:Name="DelayASlider" Minimum="0" Maximum="2000" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="DelaySlider_ValueChanged"
                                        automation:AutomationProperties.Name="Output A synchronization delay" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,4"><TextBlock Text="Output B delay" FontWeight="SemiBold" /><TextBlock x:Name="DelayBText" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" /></Grid>
                                <Slider x:Name="DelayBSlider" Minimum="0" Maximum="2000" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="DelaySlider_ValueChanged"
                                        automation:AutomationProperties.Name="Output B synchronization delay" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="CalibrationButton" Click="Calibration_Click" Content="▶  Play sync test" />
                            <Button x:Name="ResetCalibrationButton" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Click="ResetCalibration_Click" Content="Reset delays" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="28" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Engine" />
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,7" Text="STABILITY BUFFER" />
                            <ComboBox x:Name="LatencyCombo" SelectionChanged="SettingChanged" automation:AutomationProperties.Name="Audio stability buffer">
                                <ComboBoxItem Tag="50">50 ms · Responsive</ComboBoxItem>
                                <ComboBoxItem Tag="100">100 ms · Balanced</ComboBoxItem>
                                <ComboBoxItem Tag="150">150 ms · Stable</ComboBoxItem>
                                <ComboBoxItem Tag="250">250 ms · Maximum stability</ComboBoxItem>
                            </ComboBox>
                            <CheckBox x:Name="AutoReconnectCheck" Margin="0,18,0,0" Content="Reconnect automatically" Click="SettingChanged_Click" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" Width="1" />
                        <StackPanel Grid.Column="3">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Session health" />
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource MutedBrush}" Text="Status" Margin="0,0,18,0" />
                                <TextBlock x:Name="DiagnosticText" Grid.Column="1" Text="Ready to scan your playback devices." TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Foreground="{DynamicResource MutedBrush}" Text="Audio queue" Margin="0,10,18,0" />
                                <TextBlock x:Name="BufferText" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Text="—" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#0A111E" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="30,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FooterHint" Foreground="{DynamicResource MutedBrush}" Text="Tip: keep Bluetooth microphones disabled for full-quality stereo playback." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="StopButton" Style="{StaticResource SecondaryButton}" Click="Stop_Click" Content="■  Stop" IsEnabled="False" />
                    <Button x:Name="StartButton" Margin="10,0,0,0" MinWidth="150" Click="Start_Click" Content="Start streaming" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
