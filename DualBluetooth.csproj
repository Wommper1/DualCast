<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DualBluetooth</AssemblyName>
    <RootNamespace>DualBluetooth</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <Product>DualCast</Product>
    <AssemblyTitle>DualCast</AssemblyTitle>
    <Company>The Level Everything Company</Company>
    <Copyright>Copyright (c) 2026 The Level Everything Company</Copyright>
    <Description>Plays the Windows system audio on two Bluetooth devices at once, with a sync delay for each.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Keep the build machine's user name and folders out of the exe and its pdb. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <InternalsVisibleTo Include="DualBluetooth.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.3.0" />
  </ItemGroup>

</Project>
